# Storyblok CMS – Konfiguration
# Kopiere diese Datei zu ".env.local" und trage die Werte aus deinem
# Storyblok-Space ein. OHNE diese Variablen funktioniert die Seite weiterhin
# mit den lokalen Default-Inhalten (src/site/content/site.ts).

# --- Server-seitig (Content Delivery API, SSR/ISR) ---
# Preview-Token = ungespeicherte Entwuerfe sichtbar; Public-Token = nur
# veroeffentlichte Inhalte.
STORYBLOK_TOKEN=
# Region des Spaces: eu | us | ap | ca | cn
STORYBLOK_REGION=eu
# Welche Version geladen wird: published (Standard) oder draft (Vorschau).
STORYBLOK_VERSION=published

# --- Client-seitig (Visual Editor / Live-Vorschau) ---
# Oeffentlicher Bridge-Token (muss mit NEXT_PUBLIC_ beginnen).
NEXT_PUBLIC_STORYBLOK_TOKEN=
NEXT_PUBLIC_STORYBLOK_REGION=eu

# --- Passwortschutz (HTTP Basic Auth) ---
# Nur aktiv, wenn SITE_PASSWORD gesetzt ist. Auf Vercel unter
# Settings -> Environment Variables anlegen, um die Seite zu schuetzen.
# Lokal in ".env.local" setzen, wenn du die Abfrage testen willst.
# SITE_PASSWORD=geheim
# SITE_USER=wohlfahrt

# --- Kontaktformular (SMTP-Versand über /api/contact) ---
# Zugangsdaten des E-Mail-Postfachs (z. B. All-Inkl/kasserver.com).
# NUR serverseitig – niemals mit NEXT_PUBLIC_ präfixen. Auf Vercel unter
# Settings -> Environment Variables hinterlegen.
SMTP_HOST=w00efa13.kasserver.com
SMTP_PORT=587
SMTP_USER=info@fliesen-wohlfahrt.de
SMTP_PASS=
# Empfänger der Anfragen (optional, Standard = SMTP_USER).
CONTACT_TO=info@fliesen-wohlfahrt.de

# --- Optional: nur für lokale Pflege-Skripte / Storyblok-MCP ---
# Management-API-Token (Schreibzugriff auf den Space). Wird von der Website
# selbst NICHT gelesen – gehört nicht in die Vercel-Umgebung.
# STORYBLOK_MANAGEMENT_TOKEN=

# --- Legacy: Unterpfad-Hosting ---
# Praefix fuer Assets aus public/ (z. B. "/wohlfahrt" bei GitHub Pages).
# Wird auf Vercel NICHT gebraucht – `basePath` ist in next.config.mjs nicht
# gesetzt. Einziger Leser ist src/site/lib/asset.ts.
# NEXT_PUBLIC_BASE_PATH=
